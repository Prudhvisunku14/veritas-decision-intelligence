APP_ENV=development
DUCKDB_PATH=data/veritas_kpi.duckdb

# LLM Provider: "template" | "gemini" | "anthropic"
# Default is "template" — works with no API key (deterministic fallback)
LLM_PROVIDER=template

# Gemini (Google AI Studio) — set LLM_PROVIDER=gemini to enable
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Anthropic (Claude) — set LLM_PROVIDER=anthropic to enable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Frontend → Backend connection
API_BASE_URL=http://localhost:8000
